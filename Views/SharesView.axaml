<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SAMBA_Util.Models"
             x:Class="SAMBA_Util.Views.SharesView">

    <DockPanel Margin="10">

        <Button Content="+ Add Share"
                Click="OnAddShare"
                DockPanel.Dock="Top"
                Margin="0 0 0 15"
                Width="120"
                HorizontalAlignment="Left"/>

        <ListBox x:Name="ListShares">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Share">

                    <Border BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0 0 0 10">

                        <StackPanel>

                            <!-- Nombre del share -->
                            <TextBlock Text="{Binding Name}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <!-- Ruta -->
                            <TextBlock Text="{Binding Path}"
                                       FontSize="14"
                                       Margin="0 5 0 5"/>

                            <!-- Toggles -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="20"
                                        Margin="0 5 0 5">

                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="ReadOnly:"/>
                                    <ToggleSwitch IsChecked="{Binding ReadOnly}"
                                                  IsEnabled="False"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="Guests:"/>
                                    <ToggleSwitch IsChecked="{Binding AllowGuests}"
                                                  IsEnabled="False"/>
                                </StackPanel>

                            </StackPanel>

                            <!-- Botones -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="10"
                                        Margin="0 10 0 0">

                                <Button Content="Edit" Width="70"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Click="OnEditShare"/>
                                <Button Content="Delete" Width="70"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Click="OnDeleteShare"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>

</UserControl>
