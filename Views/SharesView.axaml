<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SAMBA_Util.Models"
             x:Class="SAMBA_Util.Views.SharesView">

    <DockPanel Margin="0 2 0 0">

        <!-- Botón añadir -->
        <Button Content="+ Add Share"
                Click="OnAddShare"
                DockPanel.Dock="Top"
                Margin="0 0 0 15"
                Width="120"
                HorizontalAlignment="Left"/>

        <!-- Lista de shares -->
        <ListBox x:Name="ListShares">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Share">

                    <Border BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2"
                            Margin="0 0 0 2">

                        <StackPanel Spacing="2">

                            <!-- Nombre -->
                            <TextBlock Text="{Binding Name}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <!-- Ruta -->
                            <TextBlock Text="{Binding Path}"
                                       FontSize="14"
                                       Margin="0 2 0 2"/>

                            <!-- Comentario (solo si existe) -->
                            <TextBlock Text="{Binding Comment}"
                                       FontStyle="Italic"
                                       FontSize="13"
                                       Foreground="Gray"
                                       IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <!-- Línea de toggles -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="20"
                                        Margin="0 5 0 5">

                                <StackPanel Orientation="Vertical" Spacing="5">
                                    <TextBlock Text="ReadOnly:"/>
                                    <ToggleSwitch IsChecked="{Binding ReadOnly}"
                                                  IsEnabled="False"/>
                                </StackPanel>

                                <StackPanel Orientation="Vertical" Spacing="5">
                                    <TextBlock Text="Guests:"/>
                                    <ToggleSwitch IsChecked="{Binding AllowGuests}"
                                                  IsEnabled="False"/>
                                </StackPanel>

                                <StackPanel Orientation="Vertical" Spacing="3">
                                    <TextBlock Text="Browse:"/>
                                    <ToggleSwitch IsChecked="{Binding Browseable}"
                                                  IsEnabled="False"/>
                                </StackPanel>

                            </StackPanel>
                            <!-- Advertencia de permisos -->
                            <TextBlock Text="{Binding Warning}"
                                       Foreground="OrangeRed"
                                       FontSize="12"
                                       
                                       IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                           
                            <!-- Usuarios (solo si existen) -->
                            <StackPanel Orientation="Vertical"
                                        Spacing="2"
                                        IsVisible="{Binding ValidUsers, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="Valid Users:" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding ValidUsers}" FontSize="13"/>
                            </StackPanel>

                            <!-- Botones -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="5"
                                        Margin="0 5 0 0">

                                <Button Content="Edit" Width="70"
                                        Click="OnEditShare"
                                        HorizontalContentAlignment="Center"/>

                                <Button Content="Delete" Width="70"
                                        Click="OnDeleteShare"
                                        HorizontalContentAlignment="Center"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>

</UserControl>
