<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SAMBA_Util.Views.UsersView">

    <Grid Margin="30" RowDefinitions="Auto,*" RowSpacing="20">

        <!-- FORMULARIO + TÍTULO -->
        <StackPanel Spacing="12" Grid.Row="0">

            <TextBlock Text="Username"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource ForegroundBrush}"/>

            <TextBox x:Name="UsernameBox"
                     Width="300"
                     Height="32"
                     CornerRadius="6"
                     Background="{StaticResource ControlBackgroundBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     Foreground="{StaticResource ForegroundBrush}"/>

            <TextBlock Text="Password"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource ForegroundBrush}"/>

            <TextBox x:Name="PasswordBox"
                     PasswordChar="*"
                     PlaceholderText="Leave empty if is not required. (Optional)"
                     Width="300"
                     Height="32"
                     CornerRadius="6"
                     Background="{StaticResource ControlBackgroundBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     Foreground="{StaticResource ForegroundBrush}"/>

            <Button Content="Add User"
                    Width="100"
                    Height="36"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    HorizontalAlignment="Center"
                    Click="OnAddUser"/>

            <Separator/>

            <TextBlock Text="Registered Users"
                       Margin="0 0 0 10"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource ForegroundBrush}"/>
        </StackPanel>

        <!-- LISTA CON SCROLL REAL -->
        <ScrollViewer Grid.Row="1"
                      Height="120"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="UsersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Background="{StaticResource ControlBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,5">

                            <DockPanel>

                                <TextBlock Text="{Binding}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           DockPanel.Dock="Left"/>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="10"
                                            HorizontalAlignment="Right"
                                            DockPanel.Dock="Right">

                                    <Button Content="Edit"
                                            Tag="{Binding}"
                                            Width="70"
                                            Height="30"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            
                                            Click="OnEditUser"/>

                                    <Button Content="Delete"
                                            Tag="{Binding}"
                                            Width="70"
                                            Height="30"
                                            VerticalContentAlignment="Center"
                                            
                                            HorizontalContentAlignment="Center"
                                            Click="OnDeleteUser"/>

                                </StackPanel>

                            </DockPanel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </ScrollViewer>

    </Grid>
</UserControl>
