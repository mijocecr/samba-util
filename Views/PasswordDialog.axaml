<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:media="using:Avalonia.Media"
        x:Class="SAMBA_Util.Views.PasswordDialog"
        Width="360" Height="200"
        Title="Administrator permissions"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}">

    <Border Margin="12"
            Padding="18"
            CornerRadius="10"
            Background="{StaticResource ControlBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">

        <!-- ⭐ DropShadowEffect correcto en Avalonia 11 -->
        <Border.Effect>
            <media:DropShadowEffect BlurRadius="14"
                                    
                                    Color="#000000"
                                    Opacity="0.33"/>
        </Border.Effect>

        <StackPanel Spacing="14">

            <TextBlock Text="Enter the administrator password to manage Samba:"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ForegroundBrush}"/>

            <TextBox x:Name="PwdBox"
                     KeyDown="OnPasswordKeyDown"
                     PasswordChar="●"
                     CornerRadius="6"
                     Background="{StaticResource ControlBackgroundBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     Foreground="{StaticResource ForegroundBrush}"/>

            <TextBlock x:Name="EmptyPasswordMessage"
                       Text="Password cannot be empty."
                       Foreground="Tomato"
                       FontSize="13"
                       IsVisible="False"
                       Margin="2,0,0,0"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="10">

                <Button Content="Cancel"
                        Width="90"
                        HorizontalContentAlignment="Center"
                        Classes="NeutralButton"
                        Click="OnCancel"/>

                <Button Content="OK"
                        Width="90"
                        HorizontalContentAlignment="Center"
                        Classes="AccentButton"
                        Click="OnAccept"/>

            </StackPanel>

        </StackPanel>

    </Border>
</Window>
