<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SAMBA_Util.Views.StatusView">

    <StackPanel Margin="20" Spacing="15">

        <!-- Título -->
        <TextBlock Text="Samba Service Status"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{StaticResource ForegroundBrush}"/>

        <!-- Estado de servicios -->
        <StackPanel Spacing="10">

            <!-- smbd -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="smbd:" Width="120"
                           Foreground="{StaticResource ForegroundBrush}"/>
                <Ellipse x:Name="IconSmbd"
                         Width="12" Height="12"
                         Fill="{StaticResource BorderBrush}"/>
                <TextBlock x:Name="TxtSmbd"
                           Foreground="{StaticResource ForegroundBrush}"/>
            </StackPanel>

            <!-- nmbd -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="nmbd:" Width="120"
                           Foreground="{StaticResource ForegroundBrush}"/>
                <Ellipse x:Name="IconNmbd"
                         Width="12" Height="12"
                         Fill="{StaticResource BorderBrush}"/>
                <TextBlock x:Name="TxtNmbd"
                           Foreground="{StaticResource ForegroundBrush}"/>
            </StackPanel>

            <!-- winbind -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="winbind:" Width="120"
                           Foreground="{StaticResource ForegroundBrush}"/>
                <Ellipse x:Name="IconWinbind"
                         Width="12" Height="12"
                         Fill="{StaticResource BorderBrush}"/>
                <TextBlock x:Name="TxtWinbind"
                           Foreground="{StaticResource ForegroundBrush}"/>
            </StackPanel>

        </StackPanel>

        <!-- Validación de configuración -->
        <StackPanel Spacing="5">
            <TextBlock Text="Configuration Check (testparm)"
                       FontWeight="Bold"
                       Foreground="{StaticResource ForegroundBrush}"/>

            <Border x:Name="TestparmBorder"
                    Padding="10"
                    CornerRadius="6"
                    Background="{StaticResource ControlBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <TextBlock x:Name="TxtTestparm"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource ForegroundBrush}"/>
            </Border>
        </StackPanel>

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Reload Samba" Click="OnReload"/>
            <Button Content="Restart Samba" Click="OnRestart"/>
            <Button Content="Refresh" Click="OnRefresh"/>
        </StackPanel>

        <TextBlock x:Name="TxtLastUpdate"
                   FontStyle="Italic"
                   Foreground="{StaticResource ForegroundBrush}"/>

        <TextBlock Text="Active Network Interfaces"
                   FontWeight="Bold"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource ForegroundBrush}"/>

        <StackPanel x:Name="IpListPanel" Spacing="5"/>

    </StackPanel>
</UserControl>
