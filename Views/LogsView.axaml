<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SAMBA_Util.Views.LogsView">

    <StackPanel Margin="20" Spacing="15">

        <TextBlock Text="Samba Logs" FontSize="20" FontWeight="Bold"/>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Refresh" Click="OnRefresh" Classes="neutral"/>
            <Button Content="Open Full Log" Click="OnOpenFull" Classes="accent"/>
        </StackPanel>

        <Border Background="#222" BorderBrush="#555" BorderThickness="1" CornerRadius="6" Padding="10">
            <ScrollViewer x:Name="Scroll" Height="400">
                <TextBlock x:Name="TxtLogs" FontFamily="Consolas" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

    </StackPanel>
</UserControl>