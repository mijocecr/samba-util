<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SAMBA_Util.Views.LogsView">

    <!-- Grid: título y botones toman su altura, la tarjeta de logs ocupa el resto -->
    <Grid Margin="20" RowDefinitions="Auto,Auto,*">

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Samba Logs"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{StaticResource ForegroundBrush}"/>

        <!-- Botones -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,18,0,0">
            <Button Content="Refresh"
                    HorizontalContentAlignment="Center"
                    Classes="NeutralButton"
                    Click="OnRefresh"/>

            <Button Content="Open File"
                    HorizontalContentAlignment="Center"
                    Classes="AccentButton"
                    Click="OnOpenFull"/>
        </StackPanel>

        <!-- Tarjeta elevada para logs -->
        <Border Grid.Row="2"
                Margin="0,18,0,0"
                Background="{StaticResource ControlBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Effect="drop-shadow(0 4 14 #00000055)">

            <ScrollViewer x:Name="Scroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="TxtLogs"
                           FontFamily="Consolas"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource ForegroundBrush}"/>
            </ScrollViewer>

        </Border>

    </Grid>
</UserControl>
