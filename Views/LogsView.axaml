<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SAMBA_Util.Views.LogsView">

    <StackPanel Margin="20" Spacing="18">

        <!-- Título -->
        <TextBlock Text="Samba Logs"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{StaticResource ForegroundBrush}"/>

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Refresh"
                    Classes="NeutralButton"
                    Click="OnRefresh"/>

            <Button Content="Open Full Log"
                    Classes="AccentButton"
                    Click="OnOpenFull"/>
        </StackPanel>

        <!-- Tarjeta elevada para logs -->
        <Border Background="{StaticResource ControlBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Effect="drop-shadow(0 4 14 #00000055)">

            <ScrollViewer x:Name="Scroll" Height="400">
                <TextBlock x:Name="TxtLogs"
                           FontFamily="Consolas"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource ForegroundBrush}"/>
            </ScrollViewer>

        </Border>

    </StackPanel>
</UserControl>