<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SambaUtil.Views.EditUserWindow"
        Width="420" Height="420"
        Title="Edit User"
        CanResize="False"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}">

    <Border Padding="20"
            CornerRadius="10"
            Background="{StaticResource ControlBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">

        <StackPanel Spacing="14">

            <!-- Título -->
            <TextBlock Text="User File"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource ForegroundBrush}"/>

            <!-- Username -->
            <StackPanel>
                <TextBlock Text="Username"
                           FontWeight="Bold"
                           Foreground="{StaticResource ForegroundBrush}"/>
                <TextBox x:Name="UsernameText"
                         IsReadOnly="True"
                         Background="{StaticResource ControlBackgroundBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Foreground="{StaticResource ForegroundBrush}"/>
            </StackPanel>

            <!-- UID Samba -->
            <StackPanel>
                <TextBlock Text="Samba UID"
                           FontWeight="Bold"
                           Foreground="{StaticResource ForegroundBrush}"/>
                <TextBox x:Name="SambaUidText"
                         IsReadOnly="True"
                         Background="{StaticResource ControlBackgroundBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Foreground="{StaticResource ForegroundBrush}"/>
            </StackPanel>

            <!-- UID UNIX -->
            <StackPanel>
                <TextBlock Text="UNIX UID"
                           FontWeight="Bold"
                           Foreground="{StaticResource ForegroundBrush}"/>
                <TextBox x:Name="UnixUidText"
                         IsReadOnly="True"
                         Background="{StaticResource ControlBackgroundBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Foreground="{StaticResource ForegroundBrush}"/>
            </StackPanel>

            <!-- Estado -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Enabled:"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource ForegroundBrush}"/>
                <CheckBox x:Name="EnableCheck"/>
            </StackPanel>

            <!-- Nueva contraseña -->
            <StackPanel>
                <TextBlock Text="New Password"
                           FontWeight="Bold"
                           Foreground="{StaticResource ForegroundBrush}"/>
                <TextBox x:Name="NewPasswordBox"
                         PasswordChar="●"
                         Background="{StaticResource ControlBackgroundBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Foreground="{StaticResource ForegroundBrush}"/>
            </StackPanel>

            <!-- Botones -->
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Right">

                <Button Content="Cancel"
                        Width="90"
                        Click="OnCancel"/>

                <Button Content="Save"
                        Width="90"
                        Click="OnSave"/>

            </StackPanel>

        </StackPanel>
    </Border>
</Window>
