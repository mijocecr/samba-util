<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SambaUtil.Views.EditUserWindow"
        Width="420" Height="420"
        Title="Edit User"
        CanResize="False">

    <Border Padding="20"  CornerRadius="10">
        <StackPanel Spacing="14">

            <!-- Título -->
            <TextBlock Text="User File"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <!-- Username -->
            <StackPanel>
                <TextBlock Text="Username" FontWeight="Bold"/>
                <TextBox x:Name="UsernameText" IsReadOnly="True"/>
            </StackPanel>

            <!-- UID Samba -->
            <StackPanel>
                <TextBlock Text="Samba UID" FontWeight="Bold"/>
                <TextBox x:Name="SambaUidText" IsReadOnly="True"/>
            </StackPanel>

            <!-- UID UNIX -->
            <StackPanel>
                <TextBlock Text="UNIX UID" FontWeight="Bold"/>
                <TextBox x:Name="UnixUidText" IsReadOnly="True"/>
            </StackPanel>

            <!-- Estado -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Enabled:" VerticalAlignment="Center"/>
                <CheckBox x:Name="EnableCheck"/>
            </StackPanel>

            <!-- Nueva contraseña -->
            <StackPanel>
                <TextBlock Text="New Password" FontWeight="Bold"/>
                <TextBox x:Name="NewPasswordBox" PasswordChar="●"/>
            </StackPanel>

            <!-- Botones -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Click="OnCancel"
                        HorizontalContentAlignment="Center"/>
                <Button Content="Save" Width="90" Click="OnSave"
                        HorizontalContentAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>